generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductAvailability {
  AVAILABLE
  UNAVAILABLE
  PREORDER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  FULFILLED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  ONLINE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  users     User[]
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  roleId         String         @db.Uuid
  email          String         @unique
  passwordHash   String
  fullName       String
  phone          String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  role           Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  addresses      Address[]
  carts          Cart[]
  orders         Order[]
  reviews        Review[]
  couponUsages   CouponUsage[]
  auditLogs      AuditLog[]
  inventoryHistory InventoryHistory[]

  @@index([roleId])
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  label      String?
  recipient  String
  address    String
  city       String
  region     String
  postalCode String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  products  Product[]
}

model Product {
  id           String             @id @default(uuid()) @db.Uuid
  categoryId   String             @db.Uuid
  slug         String             @unique
  name         String
  shortDescription String
  description  String
  availability ProductAvailability @default(UNAVAILABLE)
  featured     Boolean            @default(false)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)
  category     Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants     ProductVariant[]
  images       ProductImage[]
  reviews      Review[]

  @@index([categoryId])
  @@index([availability, featured])
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  name          String
  sku           String   @unique
  price         Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  currency      String
  stockQuantity    Int      @default(0)
  reservedQuantity Int      @default(0)
  lowStockThreshold Int     @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  inventoryHistory InventoryHistory[]

  @@index([productId])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  src       String
  alt       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@index([productId])
}

model Cart {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String?    @db.Uuid
  sessionToken String?    @unique
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items        CartItem[]

  @@index([userId])
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @db.Uuid
  variantId String         @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Order {
  id            String         @id @default(uuid()) @db.Uuid
  orderNumber   String         @unique
  userId        String?        @db.Uuid
  email         String
  status        OrderStatus    @default(PENDING)
  currency      String
  subtotal      Decimal        @db.Decimal(12, 2)
  shippingAmount Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @db.Decimal(12, 2)
  total         Decimal        @db.Decimal(12, 2)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  address       OrderAddress?
  payments      Payment[]
  couponUsages  CouponUsage[]
  inventoryHistory InventoryHistory[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          String          @id @default(uuid()) @db.Uuid
  orderId     String          @db.Uuid
  variantId   String?         @db.Uuid
  productName String
  variantName String?
  sku         String?
  unitPrice   Decimal         @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal         @db.Decimal(12, 2)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
}

model OrderAddress {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @unique @db.Uuid
  recipient  String
  phone      String
  address    String
  city       String
  region     String
  postalCode String
  notes      String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @db.Uuid
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  provider          String?
  providerReference String?
  idempotencyKey    String?       @unique
  metadata          Json?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([providerReference])
}

model PaymentWebhookEvent {
  id            String   @id @default(uuid()) @db.Uuid
  provider      String
  eventId       String
  payloadHash   String
  processedAt   DateTime @default(now()) @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([provider, processedAt])
}

model InventoryHistory {
  id                   String         @id @default(uuid()) @db.Uuid
  variantId            String         @db.Uuid
  orderId              String?        @db.Uuid
  userId               String?        @db.Uuid
  stockDelta           Int
  reservedDelta        Int
  stockQuantityAfter   Int
  reservedQuantityAfter Int
  reason               String
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  variant              ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order                Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user                 User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
  @@index([userId, createdAt])
}

model Review {
  id        String       @id @default(uuid()) @db.Uuid
  productId String       @db.Uuid
  userId    String?      @db.Uuid
  rating    Int
  title     String?
  body      String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([userId])
}

model Coupon {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique
  discountType DiscountType
  value       Decimal       @db.Decimal(12, 2)
  startsAt    DateTime?     @db.Timestamptz(3)
  expiresAt   DateTime?     @db.Timestamptz(3)
  maxUses     Int?
  isActive    Boolean       @default(false)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  usages      CouponUsage[]

  @@index([isActive, startsAt, expiresAt])
}

model CouponUsage {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @db.Uuid
  userId    String?  @db.Uuid
  orderId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([userId, couponId])
}

model Article {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  title       String
  excerpt     String?
  body        String
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  @@index([status, publishedAt])
}

model FAQ {
  id        String   @id @default(uuid()) @db.Uuid
  question  String
  answer    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([isActive, sortOrder])
}

model HomepageSection {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  eyebrow     String?
  title       String?
  body        String?
  imageSrc    String?
  imageAlt    String?
  ctaLabel    String?
  ctaHref     String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([isPublished, sortOrder])
}

model SiteSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
}
