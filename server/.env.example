# ── Required ──
NODE_ENV=development
PORT=4000
DATABASE_URL=your_neon_postgresql_connection_string
CORS_ORIGINS=http://localhost:3000

# ── Auth ──
AUTH_JWT_SECRET=your_jwt_secret_at_least_32_chars
AUTH_SESSION_TTL_SECONDS=86400

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Logging ──
LOG_LEVEL=info

# ── Shipping ──
SHIPPING_FLAT_AMOUNT=250

# ── Payments (optional) ──
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ── Meta Analytics (server-only, optional) ──
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_CONVERSIONS_API_ACCESS_TOKEN=
# Set only while testing in Events Manager; remove for production.
META_TEST_EVENT_CODE=
